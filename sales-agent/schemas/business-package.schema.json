{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VIDORETTO/entrepreneur-agent/main/sales-agent/schemas/business-package.schema.json",
  "type": "object",
  "required": ["schema_version", "package_version", "business", "offers", "policies", "capabilities", "sources", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["draft", "active"]},
    "non_text_policy": {"enum": ["ask_text", "offer_human"]},
    "draft_mode": {"enum": ["off", "on", "auto"]},
    "sales_posture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initiative": {"enum": ["answer", "suggest", "lead"]},
        "ask_for_close": {"type": "boolean"},
        "alternative_on_objection": {"type": "boolean"},
        "max_suggestions_per_conversation": {"type": "integer", "minimum": 0, "maximum": 3},
        "cross_sell": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when_offer", "suggest"],
            "properties": {
              "when_offer": {"type": "string", "minLength": 1},
              "suggest": {"type": "string", "minLength": 1},
              "pitch": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant_name": {"type": "string", "maxLength": 300},
        "disclose_ai": {"type": "boolean"},
        "tone": {"type": "string", "maxLength": 300},
        "address": {"enum": ["você", "tu"]},
        "emoji": {"enum": ["none", "light", "free"]},
        "max_chars": {"type": "integer", "minimum": 80, "maximum": 4000},
        "forbidden_phrases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "examples": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": ["seller"],
            "properties": {
              "situation": {"type": "string", "maxLength": 600},
              "buyer": {"type": "string", "maxLength": 600},
              "seller": {"type": "string", "minLength": 1, "maxLength": 600}
            }
          }
        }
      }
    },
    "privacy": {"type": "object", "properties": {"retention_days": {"type": "integer", "minimum": 0}}},
    "loop_policy": {"type": "object", "properties": {"fallback_limit": {"type": "integer", "minimum": 1}}},
    "service_hours": {
      "type": "object", "required": ["timezone", "intervals"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "intervals": {"type": "object", "additionalProperties": {
          "type": "array", "items": {"type": "object", "required": ["start", "end"],
          "properties": {"start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
                         "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}
        }}}
      }
    },
    "business": {
      "type": "object",
      "required": ["id", "name", "buyer_types"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "buyer_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "mode", "currency"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["physical", "digital", "service"]},
          "mode": {"enum": ["direct", "consultative", "proposal", "appointment"]},
          "currency": {"type": "string", "minLength": 1},
          "price_type": {"enum": ["fixed", "variable", "on_request"]},
          "price": {"type": "number", "minimum": 0},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "questions": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 300, "pattern": "\\?"}},
          "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "quote_validity_minutes": {"type": "integer", "minimum": 1},
          "delivery_days": {"type": "integer", "minimum": 0},
          "stock": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        },
        "allOf": [
          {
            "if": {"properties": {"price_type": {"const": "fixed"}}},
            "then": {"required": ["price"]}
          }
        ]
      }
    },
    "policies": {"type": "object"},
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {"enum": ["enabled", "assisted", "disabled", "pending"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"enum": ["disabled", "pending"]}}},
            "then": {"required": ["reason"]}
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["approved", "revoked", "pending"]},
          "content": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "approved"}}},
            "then": {"required": ["origin"]}
          }
        ]
      }
    },
    "skills": {"type": "array", "items": {"type": "object"}}
  }
}
