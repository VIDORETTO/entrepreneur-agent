{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VIDORETTO/entrepreneur-agent/main/sales-agent/schemas/business-package.schema.json",
  "type": "object",
  "required": ["schema_version", "package_version", "business", "offers", "policies", "capabilities", "sources", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["draft", "active"]},
    "business": {
      "type": "object",
      "required": ["id", "name", "buyer_types"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "buyer_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "mode", "currency"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["physical", "digital", "service"]},
          "mode": {"enum": ["direct", "consultative", "proposal", "appointment"]},
          "currency": {"type": "string", "minLength": 1},
          "price_type": {"enum": ["fixed", "variable", "on_request"]},
          "price": {"type": "number", "minimum": 0},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "quote_validity_minutes": {"type": "integer", "minimum": 1},
          "delivery_days": {"type": "integer", "minimum": 0},
          "stock": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        },
        "allOf": [
          {
            "if": {"properties": {"price_type": {"const": "fixed"}}},
            "then": {"required": ["price"]}
          }
        ]
      }
    },
    "policies": {"type": "object"},
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {"enum": ["enabled", "assisted", "disabled", "pending"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"enum": ["disabled", "pending"]}}},
            "then": {"required": ["reason"]}
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["approved", "revoked", "pending"]},
          "content": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "approved"}}},
            "then": {"required": ["origin"]}
          }
        ]
      }
    },
    "skills": {"type": "array", "items": {"type": "object"}}
  }
}
