{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vendedor-adaptavel/business-package.schema.json",
  "type": "object",
  "required": ["schema_version", "package_version", "business", "offers", "policies", "capabilities", "sources", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "minLength": 1},
    "business": {"type": "object", "required": ["id", "name", "buyer_types"]},
    "offers": {"type": "array", "minItems": 1},
    "policies": {"type": "object"},
    "capabilities": {"type": "object"},
    "sources": {"type": "array"},
    "skills": {"type": "array"}
  }
}
